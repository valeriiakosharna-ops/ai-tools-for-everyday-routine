{% macro icon(name, class="", size=24) %}<svg class="icon {{ class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{% if name == "arrow" %}<path d="M5 12h14m-6-6 6 6-6 6"/>
{% elif name == "external" %}<path d="M14 3h7v7m0-7L10 14m0-10H4v16h16v-6"/>
{% elif name == "chat" %}<path d="M20 11a8 8 0 0 1-8 8H5l-4 3 2-7a8 8 0 1 1 17-4Z"/><path d="M7 10h9m-9 4h5"/>
{% elif name == "book" %}<path d="M12 5c-3-2-6-2-10-1v15c4-1 7-1 10 1 3-2 6-2 10-1V4c-4-1-7-1-10 1Zm0 0v15"/><path d="M5 8h4m-4 4h4m6-4h4m-4 4h4"/>
{% elif name == "code" %}<path d="m8 6-6 6 6 6m8-12 6 6-6 6m-3-15-2 18"/>
{% elif name == "connect" %}<rect x="2" y="2" width="7" height="7" rx="2"/><rect x="15" y="15" width="7" height="7" rx="2"/><path d="M18 7h-3m3 0V4m0 3-7 7m-5 1v5h5"/>
{% elif name == "spark" %}<path d="m12 2 3 7 7 3-7 3-3 7-3-7-7-3 7-3 3-7Z"/>
{% elif name == "search" %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>
{% elif name == "check" %}<path d="m5 12 4 4L19 6"/>
{% elif name == "layers" %}<path d="m12 2 10 6-10 6L2 8l10-6ZM2 12l10 6 10-6M2 16l10 6 10-6"/>
{% elif name == "clock" %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{% elif name == "chevron" %}<path d="m8 10 4 4 4-4"/>
{% elif name == "menu" %}<path d="M3 6h18M3 12h18M3 18h18"/>
{% elif name == "close" %}<path d="m6 6 12 12M6 18 18 6"/>
{% elif name == "target" %}<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>
{% endif %}</svg>{% endmacro %}
